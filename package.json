{
  "name": "community-spaces",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cs/db generate",
    "db:migrate": "pnpm --filter @cs/db migrate",
    "db:seed": "pnpm --filter @cs/db seed",
    "db:studio": "pnpm --filter @cs/db studio",
    "db:places": "pnpm --filter @cs/db places"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
