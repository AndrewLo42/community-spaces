# Copy to .env at the repo root. All apps and scripts read this one file.
# In production every value below is required; the app refuses to start without them.

# Local: Homebrew Postgres (brew install postgresql@17 && createdb community_spaces).
# Production: the Neon *pooled* connection string.
DATABASE_URL=postgres://localhost:5432/community_spaces

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Required in production (e.g. https://communityspaces.app). Inferred from the request in dev.
BETTER_AUTH_URL=

# Without a Resend key, emails (including sign-in links) are printed to the dev server log.
# Production refuses to start without one.
RESEND_API_KEY=
EMAIL_FROM="Community Spaces <hello@example.com>"

# Protects the /api/cron/* jobs. Vercel Cron sends it automatically once set.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Cloudflare R2 for photos. Leave blank in dev to store uploads in .data/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
